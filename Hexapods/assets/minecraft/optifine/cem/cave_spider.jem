{
	"credit": "Created by Magpyka",
	"textureSize": [128, 128],
	"texture": "textures/entity/spider/cave_spider.png",
	"models": [
		{
			"part": "root",
			"id": "root",
			"invertAxis": "xy",
			"translate": [0, 0, 0],
			"attach": true,
			"model": "spider_animations.jpm"
		},
		{
			"part": "head",
			"id": "head",
			"invertAxis": "xy",
			"translate": [0, 0, 0],
			"submodels": [
				{
					"id": "Created_by_Magpyka",
					"invertAxis": "xy",
					"translate": [0, 0, 0]
				}
			],
			"animations": [
				{
					"var.pedipalpA": "if(is_alive && var.aggro==0, clamp(-1 +cos(var.r+(age+limb_swing)/37)*4, 0, 1), 0 )*clamp(1-limb_speed*2, 0, 1)",
					"var.pedipalp": "(0.5-0.5*cos( var.pedipalpA*pi ))",
					"right_mouth.ry": "-(right_jaw.tx+1)/4",
					"left_mouth.ry": "-(left_jaw.tx-1)/4",
					"right_mouth.tx": "right_jaw.tx+0.5",
					"left_mouth.tx": "left_jaw.tx-0.5",
					"right_palp.tz": "-0.75 -sin(swing_progress*pi*2)  -sin((limb_swing/2+age)/25*pi*2)/2*var.pedipalp",
					"left_palp.tz": " -0.75 -sin(swing_progress*pi*2)  -sin((limb_swing/2+age)/30*pi*2)/2*var.pedipalp",
					"right_palp.rx": "torad(-head_pitch)/1.5  -sin(swing_progress*pi*2)  +torad(-30*var.aggro -20*limb_speed )  +( torad(-15) -sin((limb_swing/2+age)/60*pi*2 -cos((limb_swing/2+age)/30*pi*2)/2)/3 )*var.pedipalp",
					"left_palp.rx": " torad(-head_pitch)/1.5  -sin(swing_progress*pi*2)  +torad(-30*var.aggro -20*limb_speed )  +( torad(-15) +sin((limb_swing/2+age)/60*pi*2 +cos((limb_swing/2+age)/30*pi*2)/2)/3 )*var.pedipalp",
					"right_palp.ry": "torad(-head_yaw)/3 +sin(head_pitch/60)/2  +sin(swing_progress*pi*2)/3  +torad( 10*var.aggro )",
					"left_palp.ry": " torad(-head_yaw)/3 -sin(head_pitch/60)/2  -sin(swing_progress*pi*2)/3  +torad(-10*var.aggro )",
					"right_palp.rz": "torad(-head_yaw)/2  +sin(var.b +pi/4)/40 -torad(20)*(1-cos(swing_progress*pi*2))  +torad( 20*var.aggro )  -sin((limb_swing/2+age)/25*pi)/4*var.pedipalp",
					"left_palp.rz": " torad(-head_yaw)/2  -sin(var.b +pi/4)/40 +torad(20)*(1-cos(swing_progress*pi*2))  +torad(-20*var.aggro )  -sin((limb_swing/2+age)/30*pi)/4*var.pedipalp"
				},
				{
					"leg8.rz": "leg8.rz -torad(15)",
					"leg7.rz": "leg7.rz +torad(15)",
					"leg8.tx": "leg8.tx +1.6 -var.die*2 +if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg7.tx": "leg7.tx -1.6 +var.die*2 -if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg8.ty": "leg8.ty +( 6 -1.5*var.air )*var.die +if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg7.ty": "leg7.ty +( 6 -1.5*var.air )*var.die +if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg6.rz": "leg6.rz -torad(13)",
					"leg5.rz": "leg5.rz +torad(13)",
					"leg6.tx": "leg6.tx +1.8 -var.die*4 +if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg5.tx": "leg5.tx -1.8 +var.die*4 -if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg6.ty": "leg6.ty +( 6 -1.5*var.air )*var.die +if(is_hurt, -sin(hurt_time/10*pi)*2, 0)*var.air",
					"leg5.ty": "leg5.ty +( 6 -1.5*var.air )*var.die +if(is_hurt, -sin(hurt_time/10*pi)*2, 0)*var.air",
					"leg4.rz": "leg4.rz -torad(13)",
					"leg3.rz": "leg3.rz +torad(13)",
					"leg4.tx": "leg4.tx +1.8 -var.die*4 +if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg3.tx": "leg3.tx -1.8 +var.die*4 -if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg4.ty": "leg4.ty +( 6 -1.5*var.air )*var.die +if(is_hurt, -sin(hurt_time/10*pi), 0)*var.air",
					"leg3.ty": "leg3.ty +( 6 -1.5*var.air )*var.die +if(is_hurt, -sin(hurt_time/10*pi), 0)*var.air",
					"leg2.rz": "leg2.rz -torad(15)",
					"leg1.rz": "leg1.rz +torad(15)",
					"leg2.tx": "leg2.tx +1.6 -var.die*2 +if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg1.tx": "leg1.tx -1.6 +var.die*2 -if(is_hurt, -sin(hurt_time/10*pi)*3, 0)*var.air",
					"leg2.ty": "leg2.ty +( 6 -1.5*var.air )*var.die",
					"leg1.ty": "leg1.ty +( 6 -1.5*var.air )*var.die"
				}
			]
		},
